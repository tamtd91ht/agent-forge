{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-forge/format_node.mjs\"",
            "timeout": 60,
            "statusMessage": "agent-forge: prettier"
          }
        ]
      }
    ]
  }
}
